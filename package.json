    "qa:poetry-kunten-reader": "python3 tools/poetrykuntenreadercheck.py",
    "qa:poetry-kunten-lines": "python3 tools/poetrykuntenlinecheck.py",
    "qa:poetry-kunten": "node tools/poetrykuntencheck.mjs",
    "qa:poetry-kunten-multiline": "node tools/poetrykuntenmultilinecheck.mjs",
    "qa:poetry-kunten-zoom": "node tools/poetrykuntenzoomcheck.mjs"
