{
  "name": "hanpuli-github-io-qa",
  "private": true,
  "scripts": {
    "build:voucher-editorial": "node tools/build_poetry_voucher_editorial.mjs",
    "qa:html": "git ls-files -z '*.html' ':!:templates/**' | xargs -0 html-validate",
    "qa:browser": "node tools/browsercheck.mjs",
    "qa:first-love": "python3 tools/firstlovecheck.py",
    "qa:voucher": "node tools/vouchertypecheck.mjs",
    "qa:404": "node tools/notfoundcheck.mjs",
    "qa": "npm run qa:html && npm run qa:first-love && npm run qa:voucher && npm run qa:shop && npm run qa:shop-locales && npm run qa:author-shop && npm run qa:browser && npm run qa:editorial && npm run qa:404 && npm run qa:about && npm run qa:fonts && npm run qa:wrap",
    "qa:editorial": "node tools/editorialcheck.mjs",
    "qa:shop": "node tools/shopcheck.mjs",
    "qa:shop-locales": "node tools/shoplocalecheck.mjs",
    "qa:author-shop": "node tools/author-shopcheck.mjs",
    "qa:about": "python3 tools/designcheck.py && node tools/aboutcheck.mjs",
    "qa:fonts": "node tools/fontcheck.mjs",
    "build:design": "node tools/build_design_specimens.mjs && python3 tools/build_site.py",
    "qa:wrap": "node tools/wrapcheck.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "html-validate": "11.16.0"
  }
}
